{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "run_id", "instance_id", "agent", "agent_version",
    "status", "input", "errors", "artifacts"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "instance_id": {"type": "string", "pattern": "^utrefactor:v1:[a-f0-9]{64}$"},
    "agent": {
      "enum": [
        "risk_assessment", "refactoring", "build_test_validation",
        "smell_revalidation", "iterative_repair"
      ]
    },
    "agent_version": {"type": "string", "minLength": 1},
    "status": {"const": "NOT_EXECUTED"},
    "input": {"type": "object"},
    "errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/error"}
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"agent": {"const": "build_test_validation"}, "input": {"properties": {"validation_contract_version": {"const": "4A.0"}}, "required": ["validation_contract_version"]}}, "required": ["agent", "input"]},
      "then": {"properties": {"input": {"required": [
        "validation_contract_version", "project_id", "pipeline_state", "validation_mode", "source_project_root",
        "source_test_file", "source_test_relative_path", "source_test_file_hash",
        "target_module", "target_test_class", "target_test_method", "method_signature",
        "original_method_hash", "original_method_source", "refactoring_result_ref",
        "refactoring_result", "candidate_method_ref", "candidate_file_ref",
        "candidate_method_hash", "candidate_file_hash", "build_system", "build_command",
        "target_test_command", "validation_levels", "timeout_config",
        "environment_snapshot_ref", "config_refs", "requested_at"
      ]}}}
    },
    {
      "if": {"properties": {"agent": {"const": "smell_revalidation"}, "input": {"properties": {"revalidation_contract_version": {"const": "5.0"}}, "required": ["revalidation_contract_version"]}}, "required": ["agent", "input"]},
      "then": {"properties": {"input": {"required": ["revalidation_contract_version", "pipeline_state", "project_id", "source_project_root", "source_test_file", "source_relative_path", "source_file_hash", "original_method_hash", "original_method_source", "candidate_file", "candidate_file_hash", "candidate_method", "candidate_method_hash", "target_package", "target_class", "target_method", "method_signature", "target_smell", "controlled_smells", "before_detection_ref", "phase3_result_ref", "validation_result_ref", "detector_name", "detector_version", "detector_jar", "detector_config_hash", "detection_schema_version", "requested_checks", "matching_policy_version", "revalidation_policy_version"]}}}
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
